{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && bun scripts/build-offline-cache.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:smoke": "bun run test:e2e --grep \"(SSR hydrates and project selection remains interactive|unknown route returns a useful 404 document|delivery waits for a saved response and offers a fresh postcard)$\"",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
