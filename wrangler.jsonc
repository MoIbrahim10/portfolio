{
  "name": "portfolio",
  "main": "./dist/server/server.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "263ad8907dc3ed688838c72e2e9f994f",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "portfolio-feedback",
      "database_id": "cd018928-a5c6-42b4-8f2e-bb642dc5d549",
      "migrations_dir": "migrations/feedback"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist/client"
  },
  "routes": [
    {
      "pattern": "m0code.com",
      "custom_domain": true
    }
  ]
}
